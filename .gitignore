# ---- keepIT ----

# Common data folder (App__DataRoot): SQLite dev DB, uploaded media, data-protection keys.
# Named App_Data (not "data") so it never collides with the C# Data/ source folder on
# case-insensitive filesystems. Never commit user data.
App_Data/
**/App_Data/
*.db
*.db-shm
*.db-wal

# User-uploaded media (note images) lives inside the data folder above —
# App_Data/users/<userId>/notes/<noteId>/ — so it is already ignored by those rules.
# This guard is anchored to the repo root on purpose: a global `**/media/` also swallowed
# *source* directories named media/ (e.g. web/src/features/notes/media/), which silently
# dropped an entire feature folder from commits.
/media/

# ---- .NET / ASP.NET Core ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.suo
*.cache

# Build / publish output
[Pp]ublish/
artifacts/

# Local app secrets & environment
appsettings.*.local.json
*.env
.env
.env.*
!.env.example
secrets.json

# ---- Visual Studio / Rider / VS Code ----
.vs/
.vscode/
.idea/
*.swp

# ---- Node / React frontend (web/) ----
node_modules/
dist/
dist-ssr/
