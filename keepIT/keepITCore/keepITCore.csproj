<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d31aa9dd-53d5-4fcd-80d1-dc992d5d5634</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- The default for builds that don't inject a real version (local dev, IDE). Release builds
         override it: the Docker build passes /p:Version from the git tag (see deploy/Dockerfile and
         the release workflow). Local git builds get "+<sha>" appended automatically by the SDK's
         built-in SourceLink; the Docker build receives the sha as a build arg (no .git in context). -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.12" />
    <!-- Pinned to 2.x: Microsoft.AspNetCore.OpenApi 10.0.9 (and its XML-comment source generator)
         target Microsoft.OpenApi 2.x, where IOpenApiMediaType.Example is settable. 3.x is a breaking
         major (Example became read-only) and won't compile against the .NET 10 OpenAPI stack. 2.9.0
         is the latest patched 2.x — keep on this line until the ASP.NET Core package moves to 3.x. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.7" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Pinned to the 3.1 line deliberately: 4.x requires a Six Labors licence key at build time
         (it fails the build target and downgrades to a warning), while 3.1 stays under the Split
         License that covers open-source/personal use. 3.1.12 is the last of that line, so it has
         its security patches. Moving to 4.x is a licensing decision, not a version bump. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
