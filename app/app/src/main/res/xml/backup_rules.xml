<?xml version="1.0" encoding="utf-8"?><!--
   The pre-Android 12 form of data_extraction_rules.xml. With minSdk 34 no device reads it, so it
   only mirrors those exclusions - see that file for why each one is there - rather than leave an
   empty file that would mean "back up everything" to anyone who lowers minSdk.
   Pinned by BackupRulesTest.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="keepit_net.xml"/>
    <exclude domain="file" path="offline/media"/>
</full-backup-content>
