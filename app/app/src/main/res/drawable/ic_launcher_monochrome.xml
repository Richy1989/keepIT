<!--
  keepIT themed-icon layer (Android 13+): the flat line drawing of the typewriter — paper, platen on
  its two supports, and the body with its space bar — the same mark as the web app's TypewriterIcon.
  The launcher tints it and uses only its alpha, so the stroke colour is irrelevant. The artwork is
  authored in a 40-unit box with an inner translate(8,8); the outer group scales it (x2.5) and
  centres it in the 108-unit canvas so even the base corners stay inside the 66-unit safe circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="4"
        android:translateY="6.5">
        <group
            android:translateX="8"
            android:translateY="8">
            <!-- paper -->
            <path
                android:pathData="M9,3 h6 v3 H9 z"
                android:fillColor="#00000000"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.8"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- platen (rounded bar) -->
            <path
                android:pathData="M4.5,6 L19.5,6 A1.5,1.5 0 0 1 21,7.5 A1.5,1.5 0 0 1 19.5,9 L4.5,9 A1.5,1.5 0 0 1 3,7.5 A1.5,1.5 0 0 1 4.5,6 Z"
                android:fillColor="#00000000"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.8"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- platen supports -->
            <path
                android:pathData="M7,9 v2"
                android:fillColor="#00000000"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.8"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <path
                android:pathData="M17,9 v2"
                android:fillColor="#00000000"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.8"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- body -->
            <path
                android:pathData="M6,11 h12 l2.5,8 H3.5 z"
                android:fillColor="#00000000"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.8"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <!-- space bar -->
            <path
                android:pathData="M8,16 h8"
                android:fillColor="#00000000"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.8"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </group>
    </group>
</vector>
