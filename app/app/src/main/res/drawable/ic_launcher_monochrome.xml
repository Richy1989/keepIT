<!--
  keepIT themed-icon layer (Android 13+): the flat form of the two-tone K — a round-capped stem and
  a chevron meeting at its middle, the same strokes as the rendered icon in docs/brand/keepit-icon.blend
  and the web app's KeepItIcon. The launcher tints it and uses only its alpha, so the colour is
  irrelevant. Sized so the furthest stroke edge sits 30 units from the centre, inside the 66-unit
  safe circle of the 108-unit canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- stem -->
    <path
        android:pathData="M39.7,34.9 L39.7,73.1"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="12.2"
        android:strokeLineCap="round" />
    <!-- chevron: arm up to the right, leg down to the right -->
    <path
        android:pathData="M66.7,34.9 L50.3,55.3 L68.3,73.1"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="12.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
