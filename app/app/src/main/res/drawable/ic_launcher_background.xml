<?xml version="1.0" encoding="utf-8"?>
<!--
  keepIT launcher background: the cream tile behind the rendered K. Matches the tile
  docs/brand/render_icons.py paints for the store icons (keepit_tile_base #F3ECD8 warming to
  keepit_tile_glow #FFFDF6 toward the top left); the stops approximate its falloff curve.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="37.8"
                android:centerY="5.4"
                android:gradientRadius="108">
                <item android:offset="0" android:color="#FFFFFDF6" />
                <item android:offset="0.25" android:color="#FFFBF7EB" />
                <item android:offset="0.5" android:color="#FFF7F2E2" />
                <item android:offset="0.75" android:color="#FFF4EEDB" />
                <item android:offset="1" android:color="#FFF3ECD8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
