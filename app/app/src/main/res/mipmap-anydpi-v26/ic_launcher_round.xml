<?xml version="1.0" encoding="utf-8"?>
<!--
  The typewriter icon. Foreground and background are rendered from docs/brand/keepit-icon.blend by
  docs/brand/render_icons.py; the monochrome layer (Android 13+ themed icons) is the flat line
  drawing of the same typewriter, since a shaded render has no single-colour silhouette.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
