{
  "name": "keepit-promo",
  "private": true,
  "description": "keepIT's promo video: the real app, recorded on the emulator, floating in a Remotion composition.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "npm run render:landscape && npm run render:portrait",
    "render:landscape": "remotion render src/index.ts Promo out/keepit-promo-landscape.mp4 --codec=h264 --crf=16",
    "render:portrait": "remotion render src/index.ts PromoPortrait out/keepit-promo-portrait.mp4 --codec=h264 --crf=16",
    "render:readme": "remotion render src/index.ts Promo out/keepit-promo-readme.mp4 --codec=h264 --crf=16 --frames=45-749",
    "still": "remotion still src/index.ts Promo out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@remotion/cli": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
